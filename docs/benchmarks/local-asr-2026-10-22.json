  "top_ten": [
    {
      "model": "moss",
      "why": "My meeting-quality pick. Best WER in both AMI cohorts; some technical names improved, but occasional raw stress loops."
    },
    {
      "model": "orukeet",
      "why": "My everyday dictation pick. Strong conversation results and very low processing cost; names still need context."
    },
    {
      "model": "parakeet-ultra",
      "why": "Close rival to Orukeet. Strong private usefulness and bounded stress output; very fast."
    },
    {
      "model": "qwen3-1.7b",
      "why": "Strong read speech; sometimes best on a technical term. Still competitive, without a universal accuracy lead."
    },
    {
      "model": "mega",
      "why": "Near Qwen on the common public screen; useful private output, but slower than the fast backends."
    },
    {
      "model": "mimo",
      "why": "Best clean read-speech score. Conversation and technical dictation did not justify its extra latency and ~11.7GB MLX peak."
    },
    {
      "model": "qwen3-0.6b",
      "why": "Good smaller fallback. Strong common conversation result; more private ambiguities than the larger Qwen."
    },
    {
      "model": "glm",
      "why": "Useful alternative, including some good technical names; conditional wording and other local garbling remain."
    },
    {
      "model": "canary-qwen-2.5b",
      "why": "Very good read speech, but behind the leaders on conversation. No clear private advantage."
    },
    {
      "model": "granite5",
      "why": "The October 20 release works locally, but did not displace the leaders in this configuration."
    }
  ],
  "limitations": [
    "74 private recordings have no verified human reference; text-only judgments are plausibility, not measured spoken accuracy.",
    "AMI80 has fixed word-boundary cuts; AMI336 uses production VAD; each cohort contains two meetings.",
    "139 empty outputs are not automatically errors. Selected truncation/repetition outputs remain scored.",
    "Native single-pass and MLX second-pass timing methods differ. ASR cost excludes model loading and cleanup.",
    "Mega figures are for the benchmarked Python MLX implementation, not guaranteed identical Swift-port behavior."
  ],
