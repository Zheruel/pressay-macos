{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pressay",
  "version": "2.0.0",
  "identifier": "dev.localflow.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pressay",
        "width": 1080,
        "height": 740,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private local dictation and meeting notes",
    "macOS": {
      "minimumSystemVersion": "26.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libxdo3",
          "pulseaudio-utils",
          "libdbus-1-3"
        ]
      }
    },
    "icon": [
      "icons/icon.png"
    ],
    "windows": {
      "bundleVCRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  }
}
