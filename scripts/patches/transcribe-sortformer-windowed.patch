index af4e23c..19111cd 100644
--- a/src/transcribe-mel.cpp
+++ b/src/transcribe-mel.cpp
@@ -373,6 +373,36 @@ int MelFrontend::n_frames_for(size_t n_samples) const {
     return static_cast<int>(n_samples / static_cast<size_t>(cfg_.hop_length)) + 1;
 }
 
+transcribe_status MelFrontend::compute_window(const float *pcm, size_t n_samples,
+                                               int first_frame, int count,
+                                               std::vector<float> &out_mel, int n_threads) const {
+    if (pcm == nullptr || cfg_.normalize != "none" || cfg_.pad_mode != "constant" ||
+        cfg_.hop_length <= 0 || first_frame < 0 || count <= 0 ||
+        first_frame > n_frames_for(n_samples) - count) {
+        return TRANSCRIBE_ERR_INVALID_ARG;
+    }
+    // Align the local origin to the global hop grid. More than half an FFT
+    // of real context on both sides means neither artificial local padding
+    // nor the local first pre-emphasis sample can affect a returned frame.
+    const int context = (cfg_.n_fft / 2 + 1 + cfg_.hop_length - 1) / cfg_.hop_length;
+    const int local_first = std::max(0, first_frame - context);
+    const size_t begin = static_cast<size_t>(local_first) * cfg_.hop_length;
+    const size_t end = std::min(n_samples,
+        static_cast<size_t>(first_frame + count + context) * cfg_.hop_length);
+    std::vector<float> local;
+    int n_mels = 0, n_frames = 0;
+    const transcribe_status status = compute(pcm + begin, end - begin, local, n_mels, n_frames, n_threads);
+    if (status != TRANSCRIBE_OK) return status;
+    const int offset = first_frame - local_first;
+    if (offset + count > n_frames) return TRANSCRIBE_ERR_INVALID_ARG;
+    out_mel.resize(static_cast<size_t>(n_mels) * count);
+    for (int mel = 0; mel < n_mels; ++mel) {
+        const float *row = local.data() + static_cast<size_t>(mel) * n_frames + offset;
+        std::copy(row, row + count, out_mel.data() + static_cast<size_t>(mel) * count);
+    }
+    return TRANSCRIBE_OK;
+}
